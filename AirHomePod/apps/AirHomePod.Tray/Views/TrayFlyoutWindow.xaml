<Window x:Class="AirHomePod.Tray.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AirHomePod.Tray.ViewModels"
        mc:Ignorable="d"
        Title="AirHomePod"
        Height="470" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- WPF Converter Tanımı -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Modern Windows 11 Renk Paleti -->
        <SolidColorBrush x:Key="BgBrush" Color="#F2202020" />
        <SolidColorBrush x:Key="BorderBrush" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1E88E5" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#1AFFFFFF" />

        <!-- Modern Buton Stili -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black" />
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Başlık -->
                <RowDefinition Height="Auto" /> <!-- Cihaz Seçimi -->
                <RowDefinition Height="Auto" /> <!-- Gecikme Profili -->
                <RowDefinition Height="Auto" /> <!-- Ses Ayarı -->
                <RowDefinition Height="*" />    <!-- Durum Mesajı & İstatistik -->
                <RowDefinition Height="Auto" /> <!-- Aksiyon Butonları -->
            </Grid.RowDefinitions>

            <!-- Başlık ve Durum Rozeti -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18" Margin="0,0,8,0" />
                    <TextBlock Text="AirHomePod" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" 
                        Background="{StaticResource CardBgBrush}" 
                        CornerRadius="6" 
                        Padding="8,3">
                    <TextBlock Text="ALAC Lossless" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <!-- Cihaz Seçici -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="HEDEF HOMEPOD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayText"
                          Height="34"
                          Background="{StaticResource CardBgBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BorderBrush}" />
            </StackPanel>

            <!-- Gecikme Profili -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="GECİKME PROFİLİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <UniformGrid Columns="3">
                    <RadioButton Content="⚡ ~200ms" IsChecked="True" 
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                 GroupName="LatencyGroup"
                                 Checked="LatencyUltraLow_Checked" />
                    <RadioButton Content="⚖️ ~400ms" 
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                 GroupName="LatencyGroup"
                                 Checked="LatencyBalanced_Checked" />
                    <RadioButton Content="🎵 ~1.2s" 
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                 GroupName="LatencyGroup"
                                 Checked="LatencyStable_Checked" />
                </UniformGrid>
            </StackPanel>

            <!-- Ses Seviyesi -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="SES SEVİYESİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Volume, StringFormat={}{0:F0}%}" 
                               HorizontalAlignment="Right" 
                               FontSize="11" 
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>
                <Slider Minimum="0" Maximum="100" 
                        Value="{Binding Volume, Mode=TwoWay}" 
                        IsMoveToPointEnabled="True" />
            </StackPanel>

            <!-- Durum Bilgisi ve Paket İstatistiği -->
            <Border Grid.Row="4" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="12" 
                               TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,0" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PacketsSent, StringFormat='Paket: {0}'}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="10" 
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Retransmits, StringFormat='Kurtarılan Paket: {0}'}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="10" 
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bağlan / Bağlantıyı Kes Butonu -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="Bağlan" 
                        Style="{StaticResource FluentButton}"
                        Click="ConnectButton_Click"
                        Visibility="{Binding CanConnect, Converter={StaticResource BoolToVis}}" />

                <Button Grid.Column="0" 
                        Content="Bağlantıyı Kes" 
                        Style="{StaticResource FluentButton}"
                        Background="#D32F2F"
                        Click="DisconnectButton_Click"
                        Visibility="{Binding CanDisconnect, Converter={StaticResource BoolToVis}}" />

                <Button Grid.Column="1" 
                        Content="Çıkış" 
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ExitButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
